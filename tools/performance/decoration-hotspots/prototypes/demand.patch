+//! Exact proxy heights without material shells, neighbour rules or tint records.
+//! An unknown proof is returned explicitly; it never seeds an exact surface record.
+use super::*;
+
+pub const UNKNOWN_HEIGHT: i32 = i32::MIN;
+
+impl World {
+    pub fn surface_heights(&self, points: &[(i32,i32)]) -> Result<Vec<[i32;2]>> {
+        self.check_active()?;
+        if points.len()>64 || points.iter().any(|&(x,z)| x.abs_diff(0)>29999990 || z.abs_diff(0)>29999990) {
+            return Err("height batch outside range".into());
+        }
+        let mut out=vec![[UNKNOWN_HEIGHT;2];points.len()];
+        if self.terrain.graph.requires_complete_column_order() {return Ok(out);}
+        let mut groups=std::collections::BTreeMap::<_,Vec<usize>>::new();
+        for (i,&(x,z)) in points.iter().enumerate() {
+            groups.entry((x>>4,z>>4)).or_default().push(i);
+        }
+        let mut scratch=self.take_raw_work()?;
+        for ((cx,cz),mut indices) in groups {
+            if self.adjustments.contains_key(&(cx,cz)) {continue;}
+            indices.sort_by_key(|&i| (points[i].0.div_euclid(self.terrain.cell_width),points[i].1.div_euclid(self.terrain.cell_width)));
+            let work={
+                let mut pool=self.surface_work.lock().map_err(|_|"surface work lock")?;
+                pool.iter().position(|(key,_)|*key==(cx,cz)).and_then(|i|pool.remove(i)).map(|(_,w)|w)
+            };
+            let mut job=match work {Some(w)=>Job::resume(&self.terrain,w),None=>self.terrain.job(cx*16,cz*16,false)?};
+            self.attach_tops(&mut job);
+            job.scratch.enable_dense_corners(indices.len()>1);
+            for i in indices {
+                self.check_active()?;
+                out[i]=self.surface_height(points[i].0,points[i].1,&mut job,&mut scratch)?;
+            }
+            let work=job.park();let bytes=work.retained_bytes();
+            if bytes<=2*1024*1024 {
+                let mut pool=self.surface_work.lock().map_err(|_|"surface work lock")?;
+                let mut used:usize=pool.iter().map(|(_,w)|w.retained_bytes()).sum();
+                while pool.len()>=8 || used+bytes>16*1024*1024 {
+                    let Some((_,old))=pool.pop_front() else {break;};used=used.saturating_sub(old.retained_bytes());
+                }
+                pool.push_back(((cx,cz),work));
+            }
+        }
+        self.return_raw_work(scratch)?;
+        Ok(out)
+    }
+
+    fn surface_height(&self,x:i32,z:i32,job:&mut Job<'_>,scratch:&mut crate::density::Scratch)->Result<[i32;2]> {
+        let t=&self.terrain;
+        let Some((top_y,substance))=job.surface_top(x,z) else {return Ok([t.min_y;2]);};
+        // Surface geometry is dispatched using the original non-air top biome.
+        let biome_at=|y,scratch:&mut crate::density::Scratch| {
+            let mut q=zoom_quart(self.zoom_seed,[x,y,z]);
+            q[1]=q[1].clamp(t.min_y>>2,(t.min_y+t.height-1)>>2);
+            self.source.sample(&t.graph,q,scratch,&mut None)
+        };
+        if matches!(biome_at(if t.graph.legacy {0}else{top_y+1},scratch),
+                    "minecraft:eroded_badlands"|"minecraft:frozen_ocean"|"minecraft:deep_frozen_ocean") {
+            return Ok([UNKNOWN_HEIGHT;2]);
+        }
+        let mut y=top_y;let mut block=substance;
+        while !block.solid() && y>=t.min_y {
+            y-=1;if y>=t.min_y {block=job.block([x,y,z]);}
+        }
+        let floor=if y>=t.min_y {y+1}else{t.min_y};
+        if y>=t.min_y {
+            let state=self.base_ids[block as usize];
+            if !self.palette.definition(state).motion_blocking || self.palette.tag(state,"minecraft:leaves") {
+                return Ok([UNKNOWN_HEIGHT;2]);
+            }
+            if block==Substance::Default
+                && !self.surface.height_preserving_at(&self.palette,biome_at(y,scratch),&t.graph,x,z) {
+                return Ok([UNKNOWN_HEIGHT;2]);
+            }
+        }
+        // The existing proxy freezes its highest water cell from the exact
+        // temperature at the record's fluid position, independently of snowfall.
+        let ice=if substance==Substance::Water {
+            let name=biome_at(top_y,scratch);
+            self.colors.temperature(self.biomes.get(name).ok_or("missing height biome")?,[x,top_y,z])<0.15
+        } else {false};
+        Ok([top_y+1,if ice {top_y+1}else{floor}])
+    }
+}
